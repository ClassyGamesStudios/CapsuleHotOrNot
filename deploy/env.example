# Copy to the project root as `.env` (gitignored) and fill in.
# systemd reads this file directly, so use KEY=value with no `export` and no
# quotes unless the value really contains them.

# development = test-login backdoor available, insecure defaults tolerated.
# production  = backdoor 404s and the app refuses to boot with dev secrets.
CHON_ENV=production

# Flask session signing. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin portal (/admin). Anything but "admin".
ADMIN_PASSWORD=

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# MySQL. Create a scoped user instead of reusing root:
#   CREATE USER 'chon'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL PRIVILEGES ON game_profiles_db.* TO 'chon'@'localhost';
DB_HOST=127.0.0.1
DB_USER=chon
DB_PASSWORD=
DB_NAME=game_profiles_db

# gunicorn (see deploy/gunicorn.conf.py)
BIND=127.0.0.1:8000
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT=900
LOG_LEVEL=info

# Never set FLASK_DEBUG on a public host: the Werkzeug console is remote code
# execution for anyone who can reach it.
# FLASK_DEBUG=
